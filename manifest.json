{
  "manifest_version": 3,
  "name": "SafeShield",
  "version": "1.0.0",
  "description": "Local-first privacy protector that redacts sensitive personal data before sending prompts to AI chat sites.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:11434/*", "http://127.0.0.1:11434/*"],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/ui/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "src/dashboard/dashboard.html",
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "css": ["src/ui/overlay/preview-modal.css"],
      "js": [
        "src/shared/constants.js",
        "src/shared/storage.js",
        "src/shared/vault.js",
        "src/core/validators.js",
        "src/core/patterns.js",
        "src/core/detector.js",
        "src/core/redactor.js",
        "src/ui/overlay/preview-modal.js",
        "src/content/adapters/chatgpt.js",
        "src/content/composer.js",
        "src/content/interceptor.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
