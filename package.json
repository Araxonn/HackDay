{
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changelog": "node scripts/build-changelog.js",
    "state": "node scripts/state.js",
    "state:full": "node scripts/state.js --with-tests",
    "state:check": "node scripts/state.js --check",
    "log": "node scripts/new-log-entry.js",
    "task": "node scripts/task.js",
    "task:add": "node scripts/task.js add",
    "decision": "node scripts/decision.js",
    "prepare": "node scripts/setup-hooks.js",
